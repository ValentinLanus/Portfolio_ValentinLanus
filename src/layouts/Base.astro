---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/silkscreen/400.css';
import '@fontsource-variable/fredoka';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/palettes.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Motion from '../components/Motion.astro';
import type { Locale, SiteContent } from '../i18n/types';
interface Props {
  locale: Locale;
  content: SiteContent;
}
const { locale, content } = Astro.props;
---

<!doctype html>
<html lang={locale} data-palette="terminal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {/* Aplica la paleta guardada antes de pintar. Ids = PALETTES (scripts/palette/palettes.ts). */}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var p = localStorage.getItem('palette');
        if (/^(arcade|caramelo|lava|atardecer)$/.test(p))
          document.documentElement.dataset.palette = p;
      } catch (e) {}
    </script>
    <Seo locale={locale} meta={content.meta} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
    <Motion />
  </body>
</html>
