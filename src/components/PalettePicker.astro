---
import { DEFAULT_PALETTE, PALETTES } from '../scripts/palette/palettes';
import type { SiteContent } from '../i18n/types';
interface Props {
  /** popover: botón con menú en la barra (>= 768 px). group: botones en línea dentro del menú mobile. */
  variant: 'popover' | 'group';
  palette: SiteContent['nav']['palette'];
}
const { variant, palette } = Astro.props;
// El nombre del botón dice cuál es el tema activo (al volver el foco tras elegir, el lector de
// pantalla lo anuncia). Sale con el de fábrica; picker.ts lo actualiza con la plantilla.
const buttonLabel = palette.button.replace('{name}', palette.names[DEFAULT_PALETTE]);
---

{variant === 'popover' ? (
  <div class="palette" data-palette-picker>
    <button
      class="palette__button"
      type="button"
      aria-haspopup="menu"
      aria-expanded="false"
      aria-controls="palette-menu"
      aria-label={buttonLabel}
      data-palette-button={palette.button}
    >
      {/* Brocha dibujada a mano en una grilla de 24: mango, virola y cerda, inclinada 45 grados con la
          punta hacia abajo a la izquierda. Se dibuja derecha y se gira entera. */}
      <svg
        class="palette__icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        aria-hidden="true"
        focusable="false"
      >
        <g transform="rotate(45 12 12)">
          <path class="palette__handle" d="M10.8 2.7a1.2 1.2 0 0 1 2.4 0l.6 6.8h-3.6z" />
          <path class="palette__ferrule" d="M9 9.5h6V13H9z" />
          <path class="palette__tuft" d="M9 13h6c0 4-1 7-3 9.5-2-2.5-3-5.5-3-9.5z" />
        </g>
      </svg>
    </button>
    {/* tabindex="-1": un clic en el relleno del menú lo enfoca a él en vez de dejar el foco en el
        body, así Esc y las flechas siguen respondiendo. */}
    <div
      id="palette-menu"
      class="palette__menu"
      role="menu"
      aria-label={palette.title}
      tabindex="-1"
      hidden
      data-palette-menu
    >
      {PALETTES.map((id) => (
        <button
          class="opt"
          type="button"
          role="menuitemradio"
          aria-checked={id === DEFAULT_PALETTE ? 'true' : 'false'}
          tabindex="-1"
          data-palette-option={id}
        >
          <span class="swatch" data-palette={id} aria-hidden="true">
            <span />
            <span />
            <span />
          </span>
          <span class="opt__name">{palette.names[id]}</span>
          <svg class="opt__check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <polyline points="3 8.5 6.25 11.75 13 4.75" />
          </svg>
        </button>
      ))}
    </div>
  </div>
) : (
  <div class="group" role="group" aria-labelledby="palette-group-title" data-palette-group>
    <p id="palette-group-title" class="group__title mono label">
      {palette.title}
    </p>
    <div class="group__list">
      {PALETTES.map((id) => (
        <button
          class="opt"
          type="button"
          aria-pressed={id === DEFAULT_PALETTE ? 'true' : 'false'}
          data-palette-option={id}
        >
          <span class="swatch" data-palette={id} aria-hidden="true">
            <span />
            <span />
            <span />
          </span>
          <span class="opt__name">{palette.names[id]}</span>
          <svg class="opt__check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <polyline points="3 8.5 6.25 11.75 13 4.75" />
          </svg>
        </button>
      ))}
    </div>
  </div>
)}

<script>
  import { initPicker } from '../scripts/palette/picker';
  initPicker();
</script>

<style>
  /* Contraste (WCAG 1.4.11): los bordes que delimitan o marcan usan --text-3 o --accent, que
     llegan a 4.4:1 sobre --surface y --surface-2 en los cinco temas. --border-ui de Arcade
     (#6b78a8) da 2.77:1 sobre --surface y 2.43:1 sobre --surface-2: no se usa de borde acá. */

  /* Botón de la barra: sin borde, solo la brocha. 44 x 44 de área táctil con un ícono de 20, así
     que sobresale 12 px del margen: se corre ese tanto para que la brocha quede alineada con el
     resto de la página (el popover se alinea al botón, no a la brocha). */
  .palette {
    position: relative;
    margin-right: -12px;
    --ring: var(--text-3);
    --pop-shadow: color-mix(in srgb, color-mix(in srgb, var(--bg) 40%, #000) 60%, transparent);
  }
  .palette__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--text);
    cursor: pointer;
    /* Sin el recuadro azul que Chrome Android pinta al tocar (también se ve en una tablet). */
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 0.2s,
      transform 0.15s var(--ease-out);
  }
  /* Solo con puntero que puede pasar por encima: en una tablet táctil el :hover queda pegado
     después del toque. */
  @media (hover: hover) {
    .palette__button:hover {
      background: color-mix(in srgb, var(--text) 10%, transparent);
    }
  }
  .palette__button:active {
    background: color-mix(in srgb, var(--text) 14%, transparent);
    transform: scale(0.96);
  }
  .palette__button[aria-expanded='true'] {
    background: var(--surface-2);
  }
  /* El ícono: contorno en el color del texto y la cerda llena con el --accent del tema. Los dos
     contrastan 3:1 o más con la barra en los cinco temas. El relleno se declara en el svg para que
     el grupo y las piezas no caigan en el negro por defecto. */
  .palette__icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .palette__tuft {
    fill: var(--accent);
  }

  /* Popover. Alineado al margen derecho de la página (donde termina la brocha), no al botón, que
     sobresale 12 px. */
  .palette__menu {
    position: absolute;
    z-index: 1;
    top: calc(100% + 14px);
    right: 12px;
    display: grid;
    gap: 2px;
    min-width: 220px;
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--text-3);
    border-radius: var(--radius);
    box-shadow: 0 18px 36px -14px var(--pop-shadow);
    transform-origin: top right;
  }
  .palette__menu[hidden] {
    display: none;
  }
  .palette__menu:not([hidden]) {
    animation: palette-pop 0.16s var(--ease-out);
  }
  @keyframes palette-pop {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  /* Opción: la misma pieza en el popover (menuitemradio) y en el menú mobile (aria-pressed). */
  .opt {
    display: grid;
    grid-template-columns: auto 1fr 16px;
    align-items: center;
    column-gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    background: none;
    border: 0;
    border-radius: calc(var(--radius) - 2px);
    color: var(--text-2);
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s,
      transform 0.15s var(--ease-out);
  }
  .opt:hover,
  .opt:focus-visible {
    background: var(--surface-2);
    color: var(--text);
  }
  .opt:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .opt:active {
    transform: scale(0.98);
  }
  .opt[aria-checked='true'],
  .opt[aria-pressed='true'] {
    color: var(--text);
  }
  /* La opción elegida se marca con un tilde en --accent, no solo con color de fondo o de borde. */
  .opt__check {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
  }
  .opt[aria-checked='true'] .opt__check,
  .opt[aria-pressed='true'] .opt__check {
    opacity: 1;
  }

  /* Muestra: tres puntos con --bg, --accent y --accent-2 de SU paleta (la regla global
     [data-palette] les da los tokens). El anillo viene del contenedor, en --text-3 de la paleta
     activa: sin él el punto de --bg desaparece sobre una superficie parecida. */
  .swatch {
    display: inline-flex;
    gap: 5px;
  }
  .swatch span {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--ring);
  }
  .swatch span:nth-child(1) {
    background: var(--bg);
  }
  .swatch span:nth-child(2) {
    background: var(--accent);
  }
  .swatch span:nth-child(3) {
    background: var(--accent-2);
  }

  /* Grupo dentro del menú mobile: lista vertical, una opción por fila de 44 px. */
  .group {
    --ring: var(--text-3);
    display: grid;
    gap: 10px;
  }
  .group__list {
    display: grid;
    gap: 6px;
  }
  .group .opt {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .group .opt[aria-pressed='true'] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  /* Sin JS no hay nada que abrir; en mobile el grupo del menú reemplaza al popover. */
  :global(html:not(.js)) .palette {
    display: none;
  }
  @media (max-width: 767px) {
    .palette {
      display: none;
    }
  }
</style>
