---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import ProgressBar from './ProgressBar.astro';
import BackToTop from './BackToTop.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Stack from './sections/Stack.astro';
import Projects from './sections/Projects.astro';
import Contact from './sections/Contact.astro';
import { getContent } from '../i18n';
import type { Locale } from '../i18n/types';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);
---

<Base locale={locale} content={c}>
  <ProgressBar />
  <Nav locale={locale} nav={c.nav} name={c.hero.name.join(' ')} />
  <main id="main" tabindex="-1">
    <Hero hero={c.hero} />
    <About about={c.about} />
    <Stack stack={c.stack} />
    <Projects projects={c.projects} />
    <Contact contact={c.contact} pendingText={c.projects.labels.linkPending} />
  </main>
  <footer>
    <div class="container">
      <p class="mono footer__note">{c.footer.note}</p>
    </div>
  </footer>
  <BackToTop label={c.nav.toTop} />
</Base>

<style>
  .footer__note {
    padding-block: 3rem;
    color: var(--text-3);
    border-top: 1px solid var(--border);
  }
</style>
